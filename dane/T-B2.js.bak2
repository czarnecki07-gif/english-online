    { type: "gap", text: '<span class="en">Many people are addicted with social media. → ________</span>', answers: ["many people are addicted to social media", "many people are addicted to social media."], wide: true },
    { type: "gap", text: '<span class="en">Screen time is detrimental on our health. → ________</span>', answers: ["screen time is detrimental to our health", "screen time is detrimental to our health."], wide: true },

      <tr><td class="en">go abroad</td><td class="pl">jechać za granicę</td></tr>
      <tr><td class="en">take photos</td><td class="pl">robić zdjęcia</td></tr>
      <tr><td class="en">try local food</td><td class="pl">spróbować lokalnego jedzenia</td></tr>
      <tr><td class="en">get lost</td><td class="pl">zgubić się</td></tr>

    { type: "gap", text: '<span class="pl">Jest coraz więcej dowodów na to, że spędzanie zbyt dużej ilości czasu przed ekranem jest szkodliwe.</span>', answers: ["there is growing evidence that excessive screen time is harmful", "there is growing evidence that excessive screen time is harmful.", "there is growing evidence that too much screen time is harmful"], wide: true },
